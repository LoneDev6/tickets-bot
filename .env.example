# Pterodactyl: set secrets as panel variables; do not include them in source or data backups.
DISCORD_TOKEN=
CLIENT_ID=
DISCORD_CLIENT_SECRET=
OWNER_ID=
# Optional: generated once and kept in .runtime/secrets.json when empty.
# Keep .runtime/ persistent and back up keys separately from the database.
TICKET_ENCRYPTION_KEY=
# Optional independent session secret (at least 32 characters), generated when empty.
SESSION_SECRET=

WEB_PORT=7777
WEB_HOST=127.0.0.1
PUBLIC_BASE_URL=
DATA_DIR=./data

# Keep false until Discord grants Message Content and the archive/privacy setup is verified.
MESSAGE_CONTENT_APPROVED=false
# Defaults to config.channels.ticketsNotifications; one channel only.
SUMMARY_CHANNEL_ID=
# Optional older ticket parents / bot accounts, comma-separated IDs, same guild only.
LEGACY_TICKET_PARENT_IDS=
LEGACY_BOT_IDS=

# Fill with verified facts before publishing the policy / submitting the intent request.
PRIVACY_HOSTING_REGION=
PRIVACY_EMAIL_PROVIDER=
PRIVACY_BACKUP_POLICY=

# Leave path empty to download and verify the pinned official Linux x64/arm64 connector.
# Configure the managed tunnel once in Cloudflare; token goes here, never into console answers.
CLOUDFLARED_PATH=
TUNNEL_TOKEN=
TUNNEL_PROTOCOL=auto
